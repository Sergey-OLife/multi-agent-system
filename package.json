{
  "name": "multi-agent-system",
  "version": "0.2.0",
  "description": "v0.2 routing baseline for a deterministic multi-agent router.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "multi-agent-system": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "hygiene:audit": "node scripts/hygiene-audit.mjs",
    "archive:audit": "node scripts/archive-audit.mjs",
    "state-sync:drift-audit": "node scripts/state-sync-drift-audit.mjs",
    "test": "npm run lint:boundaries --silent && npm run build --silent && node --test dist/tests/*.test.js",
    "test:core": "cd go-core && go test ./...",
    "sync-check": "node scripts/run-sync-check.mjs",
    "registry:sync": "node scripts/run-registry-sync.mjs",
    "dev": "npm run build --silent && node dist/src/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
